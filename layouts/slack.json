{
  "id": "root",
  "type": "column",
  "children": [
    {
      "id": "topbar",
      "type": "block",
      "content": {
        "mod": "slack",
        "props": {
          "view": "topbar"
        }
      },
      "size": {
        "px": 44
      },
      "window_drag": true
    },
    {
      "id": "body",
      "type": "row",
      "children": [
        {
          "id": "rail",
          "type": "block",
          "content": {
            "mod": "slack",
            "props": {
              "view": "rail"
            }
          },
          "size": {
            "px": 72
          }
        },
        {
          "id": "workspace",
          "type": "row",
          "children": [
            {
              "id": "sidebar",
              "type": "column",
              "children": [
                {
                  "id": "channels",
                  "type": "block",
                  "content": {
                    "mod": "slack",
                    "props": {
                      "view": "channels"
                    }
                  }
                }
              ],
              "size": {
                "px": 300
              },
              "min": 220,
              "max": 480
            },
            {
              "id": "work",
              "type": "column",
              "children": [
                {
                  "id": "header",
                  "type": "block",
                  "content": {
                    "mod": "slack",
                    "props": {
                      "view": "header"
                    }
                  },
                  "size": {
                    "px": 92
                  }
                },
                {
                  "id": "work-body",
                  "type": "row",
                  "children": [
                    {
                      "id": "conversation-view",
                      "type": "stack",
                      "children": [
                        {
                          "id": "main",
                          "type": "block",
                          "content": {
                            "tab": "active",
                            "pane": {
                              "background": "background",
                              "border": {
                                "width": 1,
                                "color": "background"
                              },
                              "focus": {
                                "width": 1,
                                "color": "accent"
                              },
                              "radius": 0,
                              "gap": 2
                            }
                          },
                          "background": "background"
                        },
                        {
                          "id": "conversation-page",
                          "type": "column",
                          "children": [
                            {
                              "id": "conversation-chat",
                              "type": "block",
                              "content": {
                                "mod": "slack-chat",
                                "props": {
                                  "presentation": true
                                }
                              }
                            }
                          ],
                          "background": "background",
                          "border": {
                            "width": 1,
                            "color": "background"
                          },
                          "radius": 0
                        }
                      ],
                      "active": "main"
                    },
                    {
                      "id": "panel",
                      "type": "column",
                      "children": [
                        {
                          "id": "panel-tabs",
                          "type": "block",
                          "content": {
                            "mod": "slack",
                            "props": {
                              "view": "paneltabs"
                            }
                          },
                          "size": {
                            "px": 40
                          }
                        },
                        {
                          "id": "panel-body",
                          "type": "stack",
                          "children": [
                            {
                              "id": "files",
                              "type": "block",
                              "content": {
                                "mod": "slack-files"
                              }
                            },
                            {
                              "id": "changes",
                              "type": "block",
                              "content": {
                                "mod": "changes"
                              }
                            },
                            {
                              "id": "chat-preview",
                              "type": "block",
                              "content": {
                                "mod": "chat-preview"
                              }
                            }
                          ],
                          "active": "files"
                        }
                      ],
                      "size": {
                        "px": 368
                      },
                      "min": 280,
                      "max": 900,
                      "hidden": true
                    }
                  ]
                }
              ],
              "resizable": false
            }
          ],
          "border": {
            "width": 1,
            "color": "#ffffff1f"
          },
          "radius": 8,
          "resizable": true
        },
        {
          "id": "pad-right",
          "type": "row",
          "children": [],
          "size": {
            "px": 6
          }
        }
      ],
      "resizable": false
    },
    {
      "id": "pad-bottom",
      "type": "row",
      "children": [],
      "size": {
        "px": 6
      }
    }
  ],
  "background": "#9C0000",
  "theme": {
    "light": "slack-light",
    "dark": "slack-dark"
  },
  "ui_font": "Lato",
  "terminal_padding": [
    10,
    16
  ],
  "titlebar": "none",
  "traffic_lights": [
    18,
    16
  ],
  "preview": "layouts/slack.svg",
  "toast": "slack-toast"
}
